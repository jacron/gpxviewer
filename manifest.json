{
  "name": "GPX viewer",
  "description": "Nice map for gpx tracks",
  "version": "0.2",
  "manifest_version": 3,
  "permissions": [
    "declarativeContent",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "images/icon.png",
    "default_title": "gpx viewer"
  }
}
